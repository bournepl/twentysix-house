{
  "name": "twentysix-house",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng run twentysix-house:build",
    "build:ssr": "ng run twentysix-house:build && ng run twentysix-house:server",
    "serve:ssr": "node dist/twentysix-house/server/server.mjs",
    "dev:ssr": "ng run twentysix-house:serve-ssr",
    "watch": "ng run twentysix-house:build --watch --configuration development",
    "images:house-catalog": "node tools/generate-house-catalog-images.mjs",
    "images:ourworks": "node tools/generate-ourworks-images.mjs",
    "images:seo": "node tools/generate-seo-images.mjs",
    "videos:probe": "node tools/optimize-videos.mjs --probe-only",
    "videos:optimize": "node tools/optimize-videos.mjs",
    "videos:optimize:dry-run": "node tools/optimize-videos.mjs --dry-run",
    "videos:posters": "node tools/generate-video-posters.mjs",
    "videos:posters:dry-run": "node tools/generate-video-posters.mjs --dry-run",
    "seo:validate-structured-data": "node tools/validate-structured-data.mjs",
    "seo:validate-blog": "node tools/validate-blog-seo.mjs",
    "seo:audit-media": "node tools/audit-media-seo.mjs",
    "seo:validate-prerender": "node tools/validate-prerender-site.mjs",
    "seo:validate-http": "node tools/validate-http-release.mjs",
    "test": "ng test",
    "vercel-build": "npm run build:ssr"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/google-maps": "^17.3.10",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/platform-server": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/ssr": "^17.3.7",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@ng-bootstrap/ng-bootstrap": "^16.0.0",
    "@ngx-loading-bar/core": "^7.0.0",
    "@ngx-loading-bar/router": "^7.0.0",
    "@popperjs/core": "^2.11.8",
    "aos": "^2.3.4",
    "bootstrap": "^4.6.2",
    "express": "^4.18.2",
    "jquery": "^3.7.1",
    "ngx-bootstrap": "^12.0.0",
    "ngx-clipboard": "^16.0.0",
    "ngx-fast-marquee": "^0.2.3",
    "ngx-pagination": "^6.0.3",
    "ngx-quill": "^24.0.5",
    "ngx-slick-carousel": "^17.0.0",
    "ngx-toastr": "^17.0.2",
    "perfect-scrollbar": "^1.5.5",
    "popper.js": "^1.16.1",
    "quill": "^1.3.7",
    "rellax": "^1.12.1",
    "rxjs": "~7.8.0",
    "slick-carousel": "^1.8.1",
    "sweetalert2": "^11.12.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.7",
    "@angular/cli": "^17.3.7",
    "@angular/compiler-cli": "^17.3.0",
    "@types/aos": "^3.0.7",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@types/rellax": "^1.7.7",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.35.4",
    "typescript": "~5.4.2"
  },
  "main": "dist/twentysix-house/server/server.mjs",
  "engines": {
    "node": "20"
  }
}
