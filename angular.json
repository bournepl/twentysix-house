{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "twentysix-house": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "allowedCommonJsDependencies": [
              "rellax",
              "aos"
            ],
            "outputPath": "dist/twentysix-house",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": [
                  "img/Photo/02 ผลงานการส่งมอบจริง/**/*.mp4",
                  "img/Photo/02 ผลงานการส่งมอบจริง/**/*.mov",
                  "img/Photo/02 ผลงานการส่งมอบจริง/**/*.MOV",
                  "video/**/*.mp4",
                  "video/**/*.mov",
                  "video/**/*.MOV",
                  "img/home/บ้านฮิมโขงปกเว็ป.png",
                  "img/home/LOGO.png",
                  "img/logobg.png",
                  "img/photo11.jpg",
                  "img/photo2.jpg",
                  "img/Collection/collection5.jpg",
                  "img/Collection/collection7.jpg",
                  "img/Collection/collection9.jpg",
                  "img/house1.jpg",
                  "img/house2.jpg",
                  "img/house3.jpg",
                  "img/house4.jpg",
                  "img/house5.jpg",
                  "img/house6.jpg",
                  "img/work1.jpg",
                  "img/work2.jpg",
                  "img/photo3.jpg",
                  "img/head.png",
                  "img/Logo.rar"
                ]
              }
            ],
            "styles": [
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "src/styles.scss",
              "src/assets/sass/now-ui-kit.scss",
              "src/assets/css/demo.css"
            ],
            "scripts": [],
            "server": "src/main.server.ts",
            "prerender": {
              "discoverRoutes": true,
              "routesFile": "prerender-routes.txt"
            },
            "ssr": {
              "entry": "server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1250kb",
                  "maximumError": "1500kb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "60kb",
                  "maximumError": "90kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "twentysix-house:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "twentysix-house:build:production"
            },
            "development": {
              "buildTarget": "twentysix-house:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist/twentysix-house/server",
            "main": "server.ts",
            "tsConfig": "tsconfig.server.json"
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "twentysix-house:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
