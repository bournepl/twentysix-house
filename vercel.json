{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/twentysix-house/browser",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/twentysix-house/browser/{**/*.html,*.css}",
      "excludeFiles": "{dist/twentysix-house/browser/assets/**,dist/twentysix-house/browser/media/**}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
