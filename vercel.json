{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/twentysix-house/browser",
  "functions": {
    "api/server.ts": {
      "includeFiles": "dist/twentysix-house/**",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/api/server"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/server"
    }
  ]
}
